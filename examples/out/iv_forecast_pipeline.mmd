---
title: "Implied-vol forecasting pipeline"
---
flowchart LR
    subgraph ingest["Ingest"]
        cboe(["CBOE CSV<br/><small>EOD option chains</small>"])
        yfinance{{"yfinance<br/><small>spot + VIX history</small>"}}
    end
    subgraph data["Data platform"]
        raw[("Raw store<br/><small>partitioned Parquet</small>")]
        features["Feature builder<br/><small>RV 1d/5d/22d, ATM IV, skew</small>"]
    end
    subgraph modeling["Modeling"]
        har[["HAR-RV<br/><small>OLS on realized vol lags</small>"]]
        garch[["GARCH(1,1)<br/><small>Student-t innovations</small>"]]
        lstm[["LSTM<br/><small>60-day lookback window</small>"]]
        evaluation["Evaluation<br/><small>QLIKE, MSE, Diebold-Mariano</small>"]
    end
    subgraph delivery["Delivery"]
        export[/"JSON export<br/><small>forecasts.json per tenor</small>"/]
        app("React app<br/><small>term-structure explorer</small>")
    end
    cboe -->|daily CSV| raw
    yfinance -->|REST pull| raw
    raw --> features
    features --> har
    features --> garch
    features --> lstm
    har --> evaluation
    garch --> evaluation
    lstm --> evaluation
    raw -.->|realized vol| evaluation
    evaluation -->|best model| export
    export -->|fetch| app
    evaluation ==>|retrain trigger| features
    classDef source fill:#E0F2FE,stroke:#0284C7,color:#0F172A
    class cboe source
